{
  "name": "lmu-racing-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "Telemetry, strategy and engineering tool for Le Mans Ultimate",
  "main": "src/app/main.js",
  "scripts": {
    "probe": "node src/reader/probe.js",
    "probe:scoring": "node src/reader/probe.js --buffer Scoring",
    "test": "node test/smoke.js && node --test \"test/*.test.js\"",
    "strategy": "node src/strategy/cli.js",
    "seed": "node scripts/seed.js",
    "ui:build": "vite build --config ui/vite.config.mjs",
    "app:dev": "node scripts/dev.js",
    "app": "npm run ui:build && electron src/app/main.js",
    "dist": "npm run ui:build && electron-builder --publish never",
    "dist:win": "npm run ui:build && electron-builder --win --publish never",
    "dist:dir": "npm run ui:build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "koffi": "^2.14.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.32"
  },
  "license": "MIT",
  "author": "Krisztián Imre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrekrisztian/lmu-racing-telemetry.git"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
